# Salin file ini menjadi .env lalu isi nilainya.
# JANGAN commit file .env (sudah di-ignore Git).

# Koneksi PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/personal_library_db?schema=public"

# Secret untuk menandatangani JWT. Wajib minimal 32 karakter;
# aplikasi menolak start bila kosong atau terlalu pendek (placeholder ini sengaja terlalu pendek).
# Buat nilai acak dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CHANGE_ME"

# Masa berlaku token: angka saja = detik ("3600"), atau angka + satuan s/m/h/d
# ("60s", "15m", "1h", "1d", "7d"). Format lain membuat aplikasi menolak start.
JWT_EXPIRES_IN="1d"

# Port backend (frontend Next.js memakai 3000)
PORT=3001

# Origin frontend yang boleh memanggil API (pisahkan dengan koma bila lebih dari satu)
CORS_ORIGIN="http://localhost:3000"
