meta {
  name: Register - duplicate email different case
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "User A",
    "email": "{{userAEmailUpper}}",
    "password": "password123"
  }
}

script:pre-request {
  bru.setVar("userAEmailUpper", bru.getVar("userAEmail").toUpperCase());
}

tests {
  test("status 409 (email dinormalisasi ke huruf kecil)", function () {
    expect(res.status).to.equal(409);
  });
}
