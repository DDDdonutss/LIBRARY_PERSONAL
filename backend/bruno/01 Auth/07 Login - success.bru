meta {
  name: Login - success
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{userAEmail}}",
    "password": "password123"
  }
}

script:post-response {
  bru.setVar("userAToken", res.body.accessToken);
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });

  test("mengembalikan user tanpa passwordHash", function () {
    expect(res.body.user).to.have.keys(["id", "name", "email", "createdAt"]);
    expect(res.body.user.id).to.equal(bru.getVar("userAId"));
  });

  test("mengembalikan accessToken", function () {
    expect(res.body.accessToken).to.be.a("string").and.not.empty;
  });
}
