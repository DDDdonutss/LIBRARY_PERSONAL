meta {
  name: Me - success
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/auth/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{userAToken}}
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });

  test("mengembalikan user yang sedang login tanpa passwordHash", function () {
    expect(res.body).to.have.keys(["id", "name", "email", "createdAt"]);
    expect(res.body.id).to.equal(bru.getVar("userAId"));
    expect(res.body.email).to.equal(bru.getVar("userAEmail"));
  });
}
