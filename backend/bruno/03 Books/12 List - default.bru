meta {
  name: List - default
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/books
  body: none
  auth: bearer
}

auth:bearer {
  token: {{userAToken}}
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });

  test("berisi 3 buku milik user A", function () {
    expect(res.body.data).to.have.lengthOf(3); expect(res.body.meta).to.deep.equal({ page: 1, limit: 10, total: 3, totalPages: 1 });
  });

  test("terbaru di urutan pertama", function () {
    expect(res.body.data[0].id).to.equal(bru.getVar("book3Id"));
  });
}
