meta {
  name: List - pagination
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/books?page=2&limit=2
  body: none
  auth: bearer
}

auth:bearer {
  token: {{userAToken}}
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });

  test("halaman 2 berisi 1 buku", function () {
    expect(res.body.data).to.have.lengthOf(1); expect(res.body.meta).to.deep.equal({ page: 2, limit: 2, total: 3, totalPages: 2 });
  });

  test("buku terlama di halaman terakhir", function () {
    expect(res.body.data[0].id).to.equal(bru.getVar("book1Id"));
  });
}
