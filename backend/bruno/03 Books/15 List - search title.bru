meta {
  name: List - search title
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/books?search=CLEAN
  body: none
  auth: bearer
}

auth:bearer {
  token: {{userAToken}}
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });

  test("pencarian tidak peka huruf besar/kecil dan cocok sebagian", function () {
    expect(res.body.data).to.have.lengthOf(1); expect(res.body.data[0].title).to.equal("Clean Code");
  });
}
