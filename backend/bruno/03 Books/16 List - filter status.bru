meta {
  name: List - filter status
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/books?status=COMPLETED
  body: none
  auth: bearer
}

auth:bearer {
  token: {{userAToken}}
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });

  test("hanya buku COMPLETED", function () {
    expect(res.body.data).to.have.lengthOf(1); res.body.data.forEach((b) => expect(b.status).to.equal("COMPLETED"));
  });
}
