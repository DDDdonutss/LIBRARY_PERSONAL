meta {
  name: List - filter category
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/books?categoryId={{categoryScienceId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{userAToken}}
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });

  test("hanya buku kategori Science", function () {
    expect(res.body.data).to.have.lengthOf(1); expect(res.body.data[0].id).to.equal(bru.getVar("book2Id"));
  });
}
