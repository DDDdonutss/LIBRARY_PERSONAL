meta {
  name: User B - search does not leak
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/books?search=clean
  body: none
  auth: bearer
}

auth:bearer {
  token: {{userBToken}}
}

tests {
  test("pencarian user B tidak menemukan buku user A", function () {
    expect(res.status).to.equal(200); expect(res.body.data).to.have.lengthOf(0);
  });
}
