meta {
  name: Register stats user
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Stats User",
    "email": "{{statsEmail}}",
    "password": "password123"
  }
}

script:pre-request {
  // User khusus agar angka statistik di folder ini pasti (tidak tergantung folder lain).
  bru.setVar("statsEmail", `stats.${Date.now()}@example.com`);
}

script:post-response {
  bru.setVar("statsToken", res.body.accessToken);
}

tests {
  test("status 201", function () {
    expect(res.status).to.equal(201);
  });
}
