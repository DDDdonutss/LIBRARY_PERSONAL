meta {
  name: Create - Science want to read
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/books
  body: json
  auth: bearer
}

auth:bearer {
  token: {{statsToken}}
}

body:json {
  {
    "title": "Stats Book 1",
    "author": "Penulis A",
    "categoryId": "{{categoryScienceId}}"
  }
}

tests {
  test("status 201", function () {
    expect(res.status).to.equal(201);
  });

  test("status WANT_TO_READ, kategori Science", function () {
    expect(res.body.status).to.equal("WANT_TO_READ");
    expect(res.body.category.name).to.equal("Science");
  });
}
