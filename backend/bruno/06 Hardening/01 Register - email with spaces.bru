meta {
  name: Register - email with spaces
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Hardening User",
    "email": "  {{hardeningEmailMixed}}  ",
    "password": "password123"
  }
}

script:pre-request {
  // User khusus folder ini (issue #22). Email ditulis dengan huruf besar dan
  // spasi di awal/akhir untuk menguji trim sebelum validasi.
  const email = `Hardening.${Date.now()}@Example.com`;
  bru.setVar("hardeningEmailMixed", email);
  bru.setVar("hardeningEmail", email.toLowerCase());
}

script:post-response {
  bru.setVar("hardeningToken", res.body.accessToken);
  bru.setVar("hardeningUserId", res.body.user && res.body.user.id);
}

tests {
  test("status 201 (email berspasi tidak lagi ditolak)", function () {
    expect(res.status).to.equal(201);
  });

  test("email disimpan tanpa spasi dan dalam huruf kecil", function () {
    expect(res.body.user.email).to.equal(bru.getVar("hardeningEmail"));
  });
}
