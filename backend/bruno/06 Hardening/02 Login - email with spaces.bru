meta {
  name: Login - email with spaces
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "  {{hardeningEmail}}  ",
    "password": "password123"
  }
}

tests {
  test("status 200 (email di-trim sebelum validasi)", function () {
    expect(res.status).to.equal(200);
  });

  test("login sebagai user yang sama", function () {
    expect(res.body.user.id).to.equal(bru.getVar("hardeningUserId"));
  });
}
