meta {
  name: List - search percent literal
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/books?search=%25
  body: none
  auth: bearer
}

auth:bearer {
  token: {{hardeningToken}}
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });

  test("\"%\" dicari sebagai karakter biasa, bukan wildcard", function () {
    expect(res.body.data).to.have.lengthOf(1);
    expect(res.body.data[0].title).to.equal("100% Organic");
  });
}
