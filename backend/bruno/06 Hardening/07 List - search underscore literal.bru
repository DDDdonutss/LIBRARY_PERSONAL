meta {
  name: List - search underscore literal
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/books?search=_
  body: none
  auth: bearer
}

auth:bearer {
  token: {{hardeningToken}}
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });

  test("\"_\" dicari sebagai karakter biasa, bukan wildcard", function () {
    expect(res.body.data).to.have.lengthOf(1);
    expect(res.body.data[0].title).to.equal("snake_case Guide");
  });
}
