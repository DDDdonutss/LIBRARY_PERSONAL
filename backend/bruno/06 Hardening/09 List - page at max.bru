meta {
  name: List - page at max
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/books?page=90071992547409&limit=100
  body: none
  auth: bearer
}

auth:bearer {
  token: {{hardeningToken}}
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });

  test("halaman di luar data → data kosong", function () {
    expect(res.body.data).to.have.lengthOf(0);
    expect(res.body.meta.page).to.equal(90071992547409);
  });
}
