meta {
  name: Create - categoryId empty string rejected
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/books
  body: json
  auth: bearer
}

auth:bearer {
  token: {{hardeningToken}}
}

body:json {
  {
    "title": "Kategori string kosong",
    "author": "Penulis Hardening",
    "categoryId": ""
  }
}

tests {
  // "Tanpa kategori" harus dikirim sebagai null, bukan "" (issue #31).
  test("status 400", function () {
    expect(res.status).to.equal(400);
  });

  test("categoryId string kosong bukan UUID", function () {
    expect(res.body.message).to.include("categoryId must be a UUID");
  });
}
